@model ITIGraduationProject.BLL.ViewModels.GradeVM.GradeBaseVM
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="form-group mb-3">
    <label asp-for="TraineeId" class="form-label"><i class="fa-solid fa-user"></i> Trainee</label>
    <select asp-for="TraineeId" class="form-select" asp-items="ViewBag.Trainees">
        <option value="">-- Select Trainee --</option>
    </select>
    <span asp-validation-for="TraineeId" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="SessionId" class="form-label"><i class="fa-solid fa-calendar-days"></i> Session</label>
    <select asp-for="SessionId" class="form-select" asp-items="ViewBag.Sessions">
        <option value="">-- Select Session --</option>
    </select>
    <span asp-validation-for="SessionId" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Value" class="form-label"><i class="fa-solid fa-percent"></i> Grade</label>
    <input asp-for="Value" class="form-control" type="number" min="0" max="100" />
    <span asp-validation-for="Value" class="text-danger"></span>
</div>
