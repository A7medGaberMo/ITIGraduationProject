@model ITIGraduationProject.BLL.ViewModels.CourseListVM

@{
    ViewData["Title"] = "Course Details";
}

<h2><i class="fa-solid fa-circle-info"></i> Course Details</h2>

<div class="card shadow-sm p-3 mb-3">
    <div class="card-body">
        <p><strong>ID:</strong> @Model.Id</p>
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Instructor:</strong> @Model.InstructorName</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to Courses
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fa-solid fa-pen"></i> Edit Course
    </a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this course?');">
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash"></i> Delete Course
        </button>
    </form>
</div>
