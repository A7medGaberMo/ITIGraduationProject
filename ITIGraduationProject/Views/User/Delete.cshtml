@model ITIGraduationProject.DAL.Models.User

<h2><i class="fa-solid fa-user-slash"></i> Delete User</h2>

<p>Are you sure you want to delete this user?</p>
<p><strong>@Model.Name</strong> (@Model.Role)</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
</form>
