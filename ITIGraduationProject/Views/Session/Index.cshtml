@model IEnumerable<ITIGraduationProject.BLL.ViewModels.SessionVM.SessionListVM>

@{
    ViewData["Title"] = "Sessions";
    var pageNumber = ViewBag.PageNumber as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 3;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);

    var courses = ViewBag.Courses as IEnumerable<ITIGraduationProject.DAL.Models.Course>
                  ?? Enumerable.Empty<ITIGraduationProject.DAL.Models.Course>();

    var selectedCourseName = ViewBag.SelectedCourseName as string ?? "";
    var search = ViewBag.Search as string ?? "";

    var courseList = new SelectList(courses, "Name", "Name", selectedCourseName);
}

<h2><i class="fa-solid fa-calendar-days"></i> Sessions</h2>

<!-- Search & Filter -->
<div class="mb-3 row g-2">
    <form method="get" asp-action="Index" class="col-md-6">
        <div class="input-group">
            <input type="text" name="search" value="@search" placeholder="Search by Session..." class="form-control" />
            <input type="hidden" name="courseName" value="@selectedCourseName" />
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
        </div>
    </form>

    <form method="get" asp-action="Index" class="col-md-6">
        <div class="input-group">
            <select name="courseName" class="form-select" asp-items="courseList">
                <option value="">All Courses</option>
            </select>
            <input type="hidden" name="search" value="@search" />
            <button type="submit" class="btn btn-secondary">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </div>
    </form>
</div>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Create New Session
    </a>
</p>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Course</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th style="width: 180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(item.CourseName ?? "N/A")</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit">
                            <i class="fa-solid fa-edit"></i>
                        </a>
                        <form asp-action="DeleteConfirmed" asp-route-id="@item.Id" method="post"
                              style="display:inline;" onsubmit="return confirm('Are you sure?');">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No sessions found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)"
                   asp-route-courseName="@selectedCourseName" asp-route-search="@search">
                    <i class="fa-solid fa-chevron-left"></i> Previous
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-courseName="@selectedCourseName"
                       asp-route-search="@search">@i</a>
                </li>
            }

            <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)"
                   asp-route-courseName="@selectedCourseName" asp-route-search="@search">
                    Next <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
